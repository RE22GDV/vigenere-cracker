# Downloaded language data and generated model caches (hundreds of MB).
# Recreate them with:  python -m vigenere.download_data
# (a negation cannot re-include a file inside an ignored directory,
#  so the directory itself is not ignored - only its contents)
data/*
!data/.gitkeep

# Benchmark output is regenerated by benchmarks/run_benchmarks.py.
# The committed charts live in docs/, the raw json does not.
benchmarks/results/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.eggs/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
